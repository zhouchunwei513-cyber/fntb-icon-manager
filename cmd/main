#!/bin/bash
# FNTB 图标管理器 - 启停控制脚本
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_TEMP_LOGFILE:-${TRIM_PKGVAR}/fntb.log}"
APP_DIR="${TRIM_APPDEST}"

case $1 in
start)
    cd "${APP_DIR}" || { echo "无法进入应用目录 ${APP_DIR}" > "${TRIM_TEMP_LOGFILE}"; exit 1; }

    # 首次启动：创建虚拟环境并安装依赖
    if [ ! -f venv/bin/python ]; then
        python3 -m venv venv >> "${LOG_FILE}" 2>&1
        venv/bin/pip install --no-cache-dir -r requirements.txt >> "${LOG_FILE}" 2>&1
    fi

    # 读取 wizard 配置
    if [ -n "${wizard_api_key}" ]; then
        export FNTB_API_KEY="${wizard_api_key}"
    fi
    export FNTB_PORT="${wizard_service_port:-${TRIM_SERVICE_PORT:-18080}}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"
    export URL_PREFIX="/app/com.fntb.iconmgr"

    # 直接启动 gunicorn（单 worker 避免配置读写竞态 S2）
    nohup venv/bin/gunicorn \
        -w 1 \
        -b "0.0.0.0:${FNTB_PORT}" \
        --chdir "${APP_DIR}" \
        --timeout 30 \
        --access-logfile "${TRIM_PKGVAR}/access.log" \
        --error-logfile "${TRIM_PKGVAR}/error.log" \
        server:app >> "${LOG_FILE}" 2>&1 &
    echo $! > "${PID_FILE}"
    exit 0
    ;;
stop)
    if [ -f "${PID_FILE}" ]; then
        pid=$(cat "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
            for _i in $(seq 1 10); do
                kill -0 "$pid" 2>/dev/null || break
                sleep 1
            done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
        fi
        rm -f "${PID_FILE}"
    fi
    exit 0
    ;;
restart)
    $0 stop
    sleep 1
    $0 start
    exit 0
    ;;
status)
    if [ -f "${PID_FILE}" ]; then
        pid=$(cat "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            exit 0
        fi
        rm -f "${PID_FILE}"
    fi
    exit 3
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
    ;;
esac
