#!/bin/bash
# FNTB 图标管理器 - 启停控制脚本
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/fntb.log"
APP_DIR="${TRIM_APPDEST}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

case $1 in
start)
    log_msg "=== FNTB 图标管理器启动 ==="
    log_msg "APP_DIR=${APP_DIR}"
    log_msg "TRIM_PKGVAR=${TRIM_PKGVAR}"
    log_msg "TRIM_SERVICE_PORT=${TRIM_SERVICE_PORT}"

    cd "${APP_DIR}" || { log_msg "ERROR: 无法进入应用目录 ${APP_DIR}"; exit 1; }

    # 检测 Python3
    PYTHON_BIN=""
    for p in python3 python; do
        if command -v "$p" &>/dev/null; then
            PYTHON_BIN="$p"
            break
        fi
    done

    if [ -z "${PYTHON_BIN}" ]; then
        log_msg "ERROR: 未找到 Python3，请确认系统已安装 Python 3.8+"
        exit 1
    fi

    log_msg "Python: $(which ${PYTHON_BIN}) $(${PYTHON_BIN} --version 2>&1)"

    # 优先使用虚拟环境，失败则用系统 Python + --user
    USE_VENV=false
    if [ -f venv/bin/python ]; then
        USE_VENV=true
        log_msg "使用已有虚拟环境"
    else
        log_msg "尝试创建虚拟环境..."
        if ${PYTHON_BIN} -m venv venv >> "${LOG_FILE}" 2>&1; then
            USE_VENV=true
            log_msg "虚拟环境创建成功"
        else
            log_msg "虚拟环境创建失败，尝试 pip install --user"
            mkdir -p "${TRIM_PKGVAR}/.local"
            export HOME="${TRIM_PKGVAR}"
            export PYTHONUSERBASE="${TRIM_PKGVAR}/.local"
            if ${PYTHON_BIN} -m pip install --user --no-cache-dir -r requirements.txt >> "${LOG_FILE}" 2>&1; then
                log_msg "pip install --user 成功"
            else
                log_msg "ERROR: 依赖安装失败，请查看日志"
                exit 1
            fi
        fi
    fi

    # 安装依赖
    if [ "${USE_VENV}" = true ] && [ ! -f venv/bin/gunicorn ]; then
        log_msg "安装 Python 依赖..."
        venv/bin/pip install --no-cache-dir -r requirements.txt >> "${LOG_FILE}" 2>&1
        if [ $? -ne 0 ]; then
            log_msg "ERROR: 依赖安装失败"
            exit 1
        fi
    fi

    # 配置环境变量
    if [ -n "${wizard_api_key}" ]; then
        export FNTB_API_KEY="${wizard_api_key}"
        log_msg "API Key 已设置"
    fi
    export FNTB_PORT="${wizard_service_port:-${TRIM_SERVICE_PORT:-18080}}"
    export TRIM_PKGVAR="${TRIM_PKGVAR}"
    export URL_PREFIX="/app/com.fntb.iconmgr"

    log_msg "端口: ${FNTB_PORT}"

    # 确定 gunicorn 路径
    if [ "${USE_VENV}" = true ]; then
        GUNICORN="venv/bin/gunicorn"
    else
        GUNICORN="${TRIM_PKGVAR}/.local/bin/gunicorn"
    fi

    log_msg "Gunicorn: ${GUNICORN}"

    # 启动服务
    nohup "${GUNICORN}" \
        -w 1 \
        -b "0.0.0.0:${FNTB_PORT}" \
        --chdir "${APP_DIR}" \
        --timeout 30 \
        --access-logfile "${TRIM_PKGVAR}/access.log" \
        --error-logfile "${TRIM_PKGVAR}/error.log" \
        server:app >> "${LOG_FILE}" 2>&1 &
    GPID=$!
    echo "${GPID}" > "${PID_FILE}"
    log_msg "进程已启动 PID=${GPID}"

    # 等待 3 秒检查是否存活
    sleep 3
    if kill -0 "${GPID}" 2>/dev/null; then
        log_msg "启动成功"
    else
        log_msg "ERROR: 进程启动后立即退出，请查看 error.log"
        rm -f "${PID_FILE}"
        exit 1
    fi
    exit 0
    ;;
stop)
    log_msg "=== 停止服务 ==="
    if [ -f "${PID_FILE}" ]; then
        pid=$(cat "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
            for _i in $(seq 1 10); do
                kill -0 "$pid" 2>/dev/null || break
                sleep 1
            done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
            log_msg "进程 ${pid} 已停止"
        fi
        rm -f "${PID_FILE}"
    fi
    exit 0
    ;;
restart)
    $0 stop
    sleep 1
    $0 start
    exit 0
    ;;
status)
    if [ -f "${PID_FILE}" ]; then
        pid=$(cat "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            exit 0
        fi
        rm -f "${PID_FILE}"
    fi
    exit 3
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
