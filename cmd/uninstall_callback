#!/bin/bash
# 卸载后：兜底确认旧数据已清除（若仍有残留则再清一次）
# v2.17.0: 与 uninstall_init 一致，整体清空 TRIM_PKGVAR，覆盖全部残留类型。
set +e

if [ -n "${TRIM_PKGVAR:-}" ] && [ -d "$TRIM_PKGVAR" ]; then
  rm -rf "${TRIM_PKGVAR}" 2>/dev/null
fi

if [ -n "${TRIM_PKGETC:-}" ] && [ -d "$TRIM_PKGETC" ]; then
  rm -f "${TRIM_PKGETC}/config.json" 2>/dev/null
fi

exit 0
